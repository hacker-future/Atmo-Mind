# ── AtmoAi backend ─────────────────────────────────────────────
# Copy to `.env` and adjust. All values are optional.

# HTTP
PORT=4000
NODE_ENV=development

# Comma-separated allowed browser origins, or * for any.
# In development the Vite dev server runs on 5173.
CORS_ORIGINS=*

# Serve the built frontend from this directory (leave default to serve ../dist).
# Build the frontend first with: npm run build
STATIC_DIR=

# ── Upstream Open-Meteo ────────────────────────────────────────
OM_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OM_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
REVERSE_GEOCODE_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_RETRIES=2

# ── Caching ────────────────────────────────────────────────────
# Forecasts change slowly; 5 minutes keeps you inside Open-Meteo's
# fair-use limits while still feeling live.
WEATHER_TTL_MS=300000
GEOCODE_TTL_MS=86400000
CACHE_MAX_ENTRIES=1000

# ── Rate limiting ──────────────────────────────────────────────
RATE_WINDOW_MS=60000
RATE_MAX=120

# ── Frontend ───────────────────────────────────────────────────
# Point the React app at the backend. Leave unset to have the
# browser talk to Open-Meteo directly (no backend needed).
VITE_API_URL=http://localhost:4000/api
